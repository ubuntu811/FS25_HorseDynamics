<?xml version="1.0" encoding="iso-8859-1"?>

<i3D name="jumpCross" version="1.6" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://i3d.giants.ch/schema/i3d-1.6.xsd">
  <Asset>
    <Export program="make_horse_jumps.py" version="1"/>
  </Asset>
  <Files/>
  <Materials>
    <Material name="white" materialId="1" diffuseColor="0.96 0.96 0.94 1" specularColor="0.3 0.3 0.3"/>
    <Material name="stripeA" materialId="2" diffuseColor="0.62 0.85 0.10 1" specularColor="0.3 0.3 0.3"/>
    <Material name="stripeB" materialId="3" diffuseColor="0.96 0.96 0.94 1" specularColor="0.3 0.3 0.3"/>
  </Materials>
  <Shapes externalShapesFile="jumpCross.i3d.shapes">
  </Shapes>
  <Scene>
    <TransformGroup name="jumpCross" nodeId="1">
      <TransformGroup name="clearAreas" nodeId="2">
        <TransformGroup name="clearArea1Start" translation="-1.6 0 -0.5" nodeId="3">
          <TransformGroup name="clearArea1Width" translation="3.2 0 0" nodeId="4"/>
          <TransformGroup name="clearArea1Height" translation="0 0 1.0" nodeId="5"/>
        </TransformGroup>
      </TransformGroup>
      <TransformGroup name="testAreas" nodeId="6">
        <TransformGroup name="testArea1Start" translation="-1.6 0 -0.5" nodeId="7">
          <TransformGroup name="testArea1End" translation="3.2 0 1.0" nodeId="8"/>
        </TransformGroup>
      </TransformGroup>
      <TransformGroup name="mesh" nodeId="9">
        <Shape name="jumpCross_vis" shapeId="1" static="true" castsShadows="true" receiveShadows="true" materialIds="1,2,3" nodeId="10"/>
        <Shape name="col" shapeId="2" static="true" density="0" collisionFilterGroup="0x3e" collisionFilterMask="0xfffffbff" castsShadows="false" receiveShadows="false" nonRenderable="true" materialIds="1" nodeId="11"/>
      </TransformGroup>
    </TransformGroup>
  </Scene>

</i3D>
