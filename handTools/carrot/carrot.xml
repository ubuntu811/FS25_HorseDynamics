<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<handTool type="horseCarrot" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../shared/xml/schema/handTool.xsd">
    <storeData>
        <name>
            <en>Carrot</en>
            <de>Karotte</de>
        </name>
        <functions>
            <function>Calls all the horses of the pasture to you; use again to let them go.</function>
        </functions>
        <image>store/carrot.dds</image>
        <price>15</price>
        <lifetime>1000</lifetime>
        <dailyUpkeep>0</dailyUpkeep>
        <showInStore>true</showInStore>
        <rotation>0</rotation>
        <brand>NONE</brand>
        <species>HANDTOOL</species>
        <category>handtoolsAnimals</category>
        <canBeSold>true</canBeSold>
    </storeData>

    <!-- the model is the base game's own carrot mesh (effects/unload/particle/carrot), wrapped in carrot.i3d with the hand nodes; the hand placement is the horse brush's, to be tuned in the game -->
    <base>
        <typeDesc>Horse treat</typeDesc>
        <filename>handTools/carrot/carrot.i3d</filename>
        <graphics node="graphics" lockFirstPerson="true"/>
        <handNode node="handNode"/>
        <firstPersonNode node="firstPersonNode"/>
    </base>

    <storable>
        <holderType type="HANDTOOL" node="graphics"/>
    </storable>

    <i3dMappings>
        <i3dMapping id="graphics" node="0>0" />
        <i3dMapping id="handNode" node="0>1" />
        <i3dMapping id="firstPersonNode" node="0>2" />
    </i3dMappings>
</handTool>
