<?xml version="1.0" encoding="iso-8859-1"?>

<i3D name="horseHall" version="1.6" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://i3d.giants.ch/schema/i3d-1.6.xsd">
  <Asset>
    <Export program="make_horse_hall.py" version="1"/>
  </Asset>
  <Files>
    <File fileId="1" filename="$data/shaders/vehicleShader.xml" />
    <File fileId="2" filename="$data/fillPlanes/straw_diffuse.png" />
    <File fileId="3" filename="$data/shared/default_normal.png" />
    <File fileId="4" filename="$data/shared/default_vmask.png" />
    <File fileId="5" filename="$data/shared/detailLibrary/calibrated/calibratedPaint_diffuse.png" />
    <File fileId="6" filename="$data/shared/detailLibrary/calibrated/calibratedPaint_normal.png" />
    <File fileId="7" filename="$data/shared/detailLibrary/calibrated/calibratedPaint_specular.png" />
    <File fileId="8" filename="$data/store/ui/shopWood_diffuse.png" />
  </Files>
  <Materials>
    <Material name="hall_straw" materialId="1" customShaderId="1">
      <CustomParameter name="clearCoatIntensity" value="0"/>
      <CustomParameter name="clearCoatSmoothness" value="0.5"/>
      <CustomParameter name="colorScale" value="1 1 1"/>
      <CustomParameter name="smoothnessScale" value="0.15"/>
      <Custommap name="detailDiffuse" fileId="5"/>
      <Custommap name="detailNormal" fileId="6"/>
      <Custommap name="detailSpecular" fileId="7"/>
      <Texture fileId="2"/>
      <Normalmap fileId="3"/>
      <Glossmap fileId="4"/>
    </Material>
    <Material name="hall_wood" materialId="2" customShaderId="1">
      <CustomParameter name="clearCoatIntensity" value="0"/>
      <CustomParameter name="clearCoatSmoothness" value="0.5"/>
      <CustomParameter name="colorScale" value="0.78 0.55 0.36"/>
      <CustomParameter name="smoothnessScale" value="0.25"/>
      <Custommap name="detailDiffuse" fileId="5"/>
      <Custommap name="detailNormal" fileId="6"/>
      <Custommap name="detailSpecular" fileId="7"/>
      <Texture fileId="8"/>
      <Normalmap fileId="3"/>
      <Glossmap fileId="4"/>
    </Material>
  </Materials>
  <Shapes externalShapesFile="horseHall.i3d.shapes">
  </Shapes>
  <Scene>
    <TransformGroup name="horseHall" collision="false" clipDistance="300" nodeId="1">
      <Shape name="hallFloor" shapeId="1" castsShadows="false" receiveShadows="true" materialIds="1" clipDistance="300" nodeId="2"/>
      <Shape name="hallWalls" shapeId="2" castsShadows="false" receiveShadows="true" materialIds="2" clipDistance="300" nodeId="3"/>
      <Light name="topLight" translation="0 6.4 0" rotation="-90 0 0" type="spot" color="1 0.850712 0.692" emitDiffuse="true" emitSpecular="true" castShadowMap="true" depthMapBias="0.001" depthMapResolution="2048" softShadowsLightSize="0.001" softShadowsLightDistance="15" softShadowsDepthBiasFactor="5" softShadowsMaxPenumbraSize="0.5" range="22" coneAngle="110" dropOff="4" clipDistance="200" nodeId="4"/>
      <Light name="warmLight1" translation="-7 3.2 -7" type="point" color="0.55 0.40 0.26" emitDiffuse="true" emitSpecular="true" range="14" clipDistance="200" nodeId="5"/>
      <Light name="warmLight2" translation="7 3.2 -7" type="point" color="0.55 0.40 0.26" emitDiffuse="true" emitSpecular="true" range="14" clipDistance="200" nodeId="6"/>
      <Light name="warmLight3" translation="-7 3.2 7" type="point" color="0.55 0.40 0.26" emitDiffuse="true" emitSpecular="true" range="14" clipDistance="200" nodeId="7"/>
      <Light name="warmLight4" translation="7 3.2 7" type="point" color="0.55 0.40 0.26" emitDiffuse="true" emitSpecular="true" range="14" clipDistance="200" nodeId="8"/>
    </TransformGroup>
  </Scene>

